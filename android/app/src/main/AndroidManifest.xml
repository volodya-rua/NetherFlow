<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <!-- Fire TV: NetherFlow opened on it from a phone or computer on the Wi-Fi, by DIAL (res/xml/whisperplay.xml) -->
        <meta-data android:name="whisperplay" android:resource="@xml/whisperplay" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- (DEFAULT: Fire TV's DIAL starts it by this: see whisperplay.xml) -->
                <category android:name="android.intent.category.DEFAULT" />
                <!-- on a TV's home screen too (its banner: drawable/tv_banner) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Share › NetherFlow: a song's (or a playlist's) link from YouTube, YouTube Music, a chat (SharingPlugin.received) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- the home-screen widget: what's playing, and its buttons (see NowPlayingWidget) -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="true"
            android:label="NetherFlow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>
        <!-- keeps the song playing in the background, with a "now playing" notification; and the music app a car sees
             (Android Auto): only a car, the phone's media controls and NetherFlow itself are shown the library -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Update notifications: a daily look at the latest release, run by Android (see UpdateCheckJob) -->
        <service
            android:name=".UpdateCheckJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- Android Auto: a media app -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

    <!-- TVs (Android TV, Google TV): worked with the remote, no touchscreen needed -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- (a camera isn't needed: without one, a QR code is read from a picture) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android Auto and Google's assistant: seen, so their signatures can be checked (PlaybackService.trusted) -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <!-- whether Android Auto is running: the provider it keeps for apps to ask (see PlaybackPlugin.carState) -->
        <provider android:authorities="androidx.car.app.connection" />
        <!-- voice control: the phone's speech recognizer (VoicePlugin) -->
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- on a TV only: to hear the phones and computers on the Wi-Fi looking for a TV to play on (CastPlugin's receiver) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- updates (UpdatePlugin): NetherFlow's own APK from GitHub hands a newer one to Android's installer (never in an app store's build) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- the phone kept awake while a song plays (and its Wi-Fi), never longer: see PlaybackService.hold -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- MobiVib (Sound › MobiVib, off till turned on): the phone taps with the music -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Library › Import › Scan a QR code: asked for the first time it's used, the camera on only while the scanner's open,
         its picture read on the phone and never kept -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Settings › Start by itself in the car (off till the user allows it, in the phone's own settings): with it, Android
         lets NetherFlow open itself in the background when Android Auto connects or the car asks for a song — the only
         way Android has for that. Nothing is ever drawn over other apps (PlaybackService.startItself). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Voice control (the mic by Search, and in Drive mode): asked for the first time it's used; the mic on only while
         it's listening for one sentence, recognized on the phone where it can (VoicePlugin) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
