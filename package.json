{
  "name": "netherflow",
  "productName": "NetherFlow",
  "version": "1.4.1",
  "description": "NetherFlow by Volodya.rua: search any song, hear it in full, read the lyrics in sync.",
  "author": "Volodya.rua",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron selftest.js",
    "dist": "node tools/fetch-yt-dlp.js && electron-builder --win --publish never",
    "android:web": "node -e \"const fs=require('fs');for(const to of ['www','android/app/src/main/assets/public']){fs.mkdirSync(to,{recursive:true});for(const f of ['index.html','lib.js','legal.html','frame-helper.js','logo.png'])fs.copyFileSync(f,to+'/'+f);for(const d of ['licenses','fonts']){fs.rmSync(to+'/'+d,{recursive:true,force:true});fs.cpSync(d,to+'/'+d,{recursive:true})}}\"",
    "android:sync": "npm run android:web && cap sync android",
    "android": "android-build.cmd",
    "fetch-yt-dlp": "node tools/fetch-yt-dlp.js",
    "site:legal": "node tools/site-legal.js",
    "race:three": "node -e \"const fs=require('fs'),s='node_modules/three/',d='race/three/';for(const f of ['build/three.module.js','build/three.core.js'])fs.cpSync(s+f,d+f.split('/').pop());fs.cpSync(s+'LICENSE','licenses/three.js-MIT.txt');for(const f of ['loaders/GLTFLoader.js','utils/BufferGeometryUtils.js','utils/SkeletonUtils.js','libs/meshopt_decoder.module.js','postprocessing/EffectComposer.js','postprocessing/RenderPass.js','postprocessing/ShaderPass.js','postprocessing/MaskPass.js','postprocessing/Pass.js','postprocessing/UnrealBloomPass.js','postprocessing/OutputPass.js','shaders/CopyShader.js','shaders/LuminosityHighPassShader.js','shaders/OutputShader.js'])fs.cpSync(s+'examples/jsm/'+f,d+'addons/'+f)\"",
    "dist:linux": "node tools/fetch-yt-dlp.js linux && electron-builder --linux --publish never"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "three": "0.186.1"
  },
  "build": {
    "appId": "io.github.volodya_rua.netherflow",
    "files": [
      "main.js",
      "preload.js",
      "island.html",
      "island-preload.js",
      "logo.png",
      "server.js",
      "lib.js",
      "frame-helper.js",
      "index.html",
      "legal.html",
      "licenses/**",
      "fonts/**",
      "emoji/**",
      "race/**",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "extraResources": [
        {
          "from": "vendor/yt-dlp/yt-dlp.exe",
          "to": "yt-dlp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetherFlow",
      "uninstallDisplayName": "NetherFlow",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NetherFlow-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "NetherFlow.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "AudioVideo",
      "executableName": "netherflow",
      "synopsis": "Search any song, hear it in full, read the lyrics in sync",
      "maintainer": "Volodya.rua <341986736+volodya-rua@users.noreply.github.com>",
      "artifactName": "NetherFlow-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/yt-dlp/yt-dlp",
          "to": "yt-dlp"
        }
      ]
    },
    "copyright": "Copyright © 2026 Volodya.rua",
    "publish": [
      {
        "provider": "github",
        "owner": "volodya-rua",
        "repo": "NetherFlow"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://volodya-rua.github.io/NetherFlow/"
}
