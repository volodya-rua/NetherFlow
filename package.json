{
  "name": "netherflow",
  "productName": "NetherFlow",
  "version": "1.1.0",
  "description": "NetherFlow by Volodya.rua: search any song, hear it in full, read the lyrics in sync.",
  "author": "Volodya.rua",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron selftest.js",
    "dist": "node tools/fetch-yt-dlp.js && electron-builder --win --publish never",
    "android:web": "node -e \"const fs=require('fs');for(const to of ['www','android/app/src/main/assets/public']){fs.mkdirSync(to,{recursive:true});for(const f of ['index.html','lib.js','legal.html','frame-helper.js','logo.png'])fs.copyFileSync(f,to+'/'+f);for(const d of ['licenses','fonts'])fs.cpSync(d,to+'/'+d,{recursive:true})}\"",
    "android:sync": "npm run android:web && cap sync android",
    "android": "android-build.cmd",
    "fetch-yt-dlp": "node tools/fetch-yt-dlp.js"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.volodya_rua.netherflow",
    "files": [
      "main.js",
      "preload.js",
      "island.html",
      "island-preload.js",
      "logo.png",
      "server.js",
      "lib.js",
      "frame-helper.js",
      "index.html",
      "legal.html",
      "licenses/**",
      "fonts/**",
      "emoji/**",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetherFlow",
      "uninstallDisplayName": "NetherFlow",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NetherFlow-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "NetherFlow.exe"
    },
    "copyright": "Copyright © 2026 Volodya.rua",
    "extraResources": [
      {
        "from": "vendor/yt-dlp/yt-dlp.exe",
        "to": "yt-dlp.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "volodya-rua",
        "repo": "NetherFlow"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
